# ── Contact form email delivery (server-only) ───────────────────────────────
# Copy this file to .env.local and fill in the values. .env.local is gitignored
# and these variables are read only inside the 'use server' action, so nothing
# here is ever exposed to the browser. Do NOT prefix any of them with NEXT_PUBLIC_.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiries are delivered. Defaults to Info@Onespheree.com if unset.
CONTACT_TO_EMAIL=Info@Onespheree.com

# The From address. Resend requires a verified domain; until onespheree.com is
# verified in the Resend account, use their onboarding sender:
#   CONTACT_FROM_EMAIL=OneSpheree Website <onboarding@resend.dev>
CONTACT_FROM_EMAIL=OneSpheree Website <no-reply@onespheree.com>

# Local development only (ignored unless NODE_ENV=development). Set to 1 to skip
# the Resend call entirely: the enquiry is printed to the server console and the
# form reports success, so the submit → loading → confirmation flow can be worked
# on without a key and without burning quota.
# CONTACT_DRY_RUN=1
